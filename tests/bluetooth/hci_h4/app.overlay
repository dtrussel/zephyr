/ {
	chosen {
		zephyr,bt-hci = &h4_test_hci;
	};

	h4-test-uart {
		compatible = "vnd,h4-test-uart";
		status = "okay";

		h4_test_hci: bt_hci_uart {
			compatible = "zephyr,bt-hci-uart";
			status = "okay";
		};
	};
};
